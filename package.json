{
  "name": "planpath-monorepo",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "dev": "pnpm --parallel --filter server --filter client dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "playwright": "^1.63.0"
  },
  "packageManager": "pnpm@12.8.1"
}
